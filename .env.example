# Copy to .env.local and fill in.

# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe dashboard (test mode) > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...

# Local: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: Stripe dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase console > Project settings > General > Your apps > Web app config (public values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated Google account emails allowed into /admin
ADMIN_EMAILS=
